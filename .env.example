AI_GATEWAY_API_KEY=

# Neon Postgres connection string (spend-cap tables). From the Neon project dashboard.
DATABASE_URL=

# Neon Auth (managed Better Auth). Base URL from `provision_neon_auth` / Neon dashboard.
NEON_AUTH_BASE_URL=
# Secret for signing session cookies. Minimum 32 chars: `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=

# Stripe (prepaid wallet top-ups; we are the merchant of record). Test-mode keys
# are fine for local dev. From the Stripe dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. Local dev: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a whsec_… ; in prod, copy it from the dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# Reseller margin over raw AI Gateway cost (the wallet burns at this multiple).
# Optional; defaults to 2 (2×). Example: 1.5 for a 50% markup.
BILLING_MARKUP=2